// Copy this file to Config/Secrets.xcconfig (git-ignored) and paste your
// Anthropic API key from https://platform.claude.com/settings/keys
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// No quotes, no spaces around the key. Then clean-build (Shift-Cmd-K)
// and run the watch app again.

CLAUDE_API_KEY = sk-ant-REPLACE_ME
