<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WeatherKit removed: requires paid Apple Developer Program.
	     Re-add via Xcode's +Capability → WeatherKit after joining, and
	     flip WeatherConfig.preferWeatherKit in WeatherProviding.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sguzyayev.dronecast</string>
	</array>
</dict>
</plist>
